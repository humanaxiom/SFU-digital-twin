# Public https://sfuai.ca:8017/ -> router LAN 192.168.1.80:18087 -> nginx TLS:8007.
# Deployment settings only; no credentials. Explicit cached local build image.
WAYFINDING_CANDIDATE_RUN=sh-navigation-exact-20260923
WAYFINDING_BROWSER_BUILD_IMAGE=wayfinding-build:local
WAYFINDING_CANDIDATE_BIND_ADDRESS=127.0.0.1
WAYFINDING_CANDIDATE_PORT=18107
WAYFINDING_EXTERNAL_BIND_ADDRESS=0.0.0.0
WAYFINDING_EXTERNAL_PORT=18087
# Existing shared certificate input, mounted read-only; no secret contents here.
WAYFINDING_TLS_CERT_DIR=C:/repos/web/certs
